# Jira Data Center Credentials (jiraeu.epam.com)
# Get token: jiraeu.epam.com → Profile → Personal Access Tokens
# Note: JIRA_EMAIL is NOT required for Jira Data Center (PAT auth only)
JIRA_BASE_URL=https://jiraeu.epam.com
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_PAT_here

# === GITLAB ===
# Create at: https://githyd.epam.com/-/profile/personal_access_tokens
# (or your GitLab instance's profile/personal_access_tokens page)
# Required scopes: api
# Token format: glpat-...
GITLAB_TOKEN=glpat_your_token_here
