# Jira credentials (replace with your Jira instance URL)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_PAT_here

# === GITLAB ===
# Create a project access token in your GitLab instance (for example, gitlab.example.com)
# Required scopes: api
# Token format: glpat-...
GITLAB_TOKEN=glpat_your_token_here
